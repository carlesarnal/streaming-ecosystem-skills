    {"name": "amount", "type": "double"},
    {"name": "currency", "type": "string"},
    {"name": "createdAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "channel", "type": "string", "default": "web", "doc": "Sales channel. Informational only."}
  ]
}
